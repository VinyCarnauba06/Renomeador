# Configurar essas vars no dashboard do Vercel (Project Settings -> Environment Variables).
# NUNCA commitar um .env real com valores reais.

# 1) Provedor de IA — configure PELO MENOS UM dos dois abaixo (se ambos existirem, Gemini tem prioridade
#    a menos que AI_PROVIDER=anthropic seja definido):

# Opção A (recomendada — mais rápida e barata): Google AI Studio (aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# Opção B: Anthropic API (console.anthropic.com -> API Keys)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Opcional: force "gemini" ou "anthropic" quando tiver as duas chaves configuradas
# AI_PROVIDER=gemini

# 2) Segredo compartilhado entre o front-end e /api/extract — qualquer string aleatória forte.
# Gerar com: openssl rand -hex 32
# O mesmo valor é colado no painel "⚙ IA" da aplicação (salvo no localStorage do navegador).
RENOMEADOR_SHARED_SECRET=

# 3) Supabase (opcional, mas recomendado — habilita cache SHA-256 de IA e sincronização na nuvem de condomínios aprendidos)
# Encontre em: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://npxyawxxyqncsbdrqcir.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

