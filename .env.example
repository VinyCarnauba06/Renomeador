# Configurar essas duas vars no dashboard do Vercel (Project Settings -> Environment Variables),
# NUNCA commitar um .env real com valores reais.

# Chave da Anthropic API (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Segredo compartilhado entre o front-end (script.js) e este backend — qualquer string aleatória forte.
# Gerar com: openssl rand -hex 32
# O mesmo valor é colado no navegador quando o app pedir "Cole a chave de acesso do backend de IA".
RENOMEADOR_SHARED_SECRET=
